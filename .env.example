# =============================================================================
# BuildSignal — Environment Variables Configuration
# =============================================================================

# Convex Backend URL (e.g. https://clever-labrador-928.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=https://clever-labrador-928.convex.cloud

# Convex HTTP Actions Site URL (e.g. https://clever-labrador-928.convex.site)
CONVEX_SITE_URL=https://clever-labrador-928.convex.site

# Clerk Authentication Keys (Get these from your Clerk Dashboard: https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk JWT Issuer Domain for Convex Auth (Configure in Convex Dashboard > Environment Variables)
CLERK_JWT_ISSUER_DOMAIN=https://...clerk.accounts.dev

# Google Gemini API Key for synthesis (Configure in Convex Dashboard > Environment Variables)
GEMINI_API_KEY=AIzaSy...
